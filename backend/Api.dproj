<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{765CFC7C-1F8C-46DD-85DD-2CFC1764783D}</ProjectGuid>
        <ProjectVersion>20.3</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win32</Platform>
        <ProjectName Condition="'$(ProjectName)'==''">Api</ProjectName>
        <TargetedPlatforms>1</TargetedPlatforms>
        <AppType>Console</AppType>
        <MainSource>Api.dpr</MainSource>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_DcuOutput>.\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>.\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <SanitizedProjectName>Api</SanitizedProjectName>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;System.Win;Data.Win;$(DCC_Namespace)</DCC_Namespace>
        <DCC_UnitSearchPath>src\config;src\database;src\repositories;src\services;src\controllers;src\routes;src\middleware;src\http;src\log;..\Compartilhada\Comum;..\Compartilhada\Models;..\Compartilhada\Models\Enums;modules;modules\.dcp;modules\.dcu;modules\github_com_hashload_horse\src;modules\github_com_gabrielbaltazar_gbswagger\Source\Core;modules\github_com_gabrielbaltazar_gbswagger\Source\Horse;modules\github_com_gabrielbaltazar_gbswagger\Source\Validator;modules\github_com_gabrielbaltazar_gbswagger\Source\Datasnap;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_ConsoleTarget>true</DCC_ConsoleTarget>
        <!-- W1029 vem da biblioteca GBSwagger (construtores duplicados para C++); irrelevante em Delphi -->
        <DCC_DUPLICATE_CTOR_DTOR>false</DCC_DUPLICATE_CTOR_DTOR>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base_Win32)'!=''">
        <VerInfo_Locale>1046</VerInfo_Locale>
        <VerInfo_Keys>CompanyName=;FileDescription=BDMG - API de Tarefas;FileVersion=1.0.0.0;InternalName=Api;LegalCopyright=;LegalTrademarks=;OriginalFilename=Api.exe;ProductName=BDMG - API de Tarefas;ProductVersion=1.0.0.0;Comments=</VerInfo_Keys>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_DebugInformation>0</DCC_DebugInformation>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\Compartilhada\Comum\ApiConstantes.pas"/>
        <DCCReference Include="..\Compartilhada\Comum\ConfiguracaoApi.pas"/>
        <DCCReference Include="..\Compartilhada\Models\BaseModel.pas"/>
        <DCCReference Include="..\Compartilhada\Comum\Paginacao.pas"/>
        <DCCReference Include="..\Compartilhada\Models\Enums\StatusTarefaEnum.pas"/>
        <DCCReference Include="..\Compartilhada\Models\Enums\PrioridadeTarefaEnum.pas"/>
        <DCCReference Include="..\Compartilhada\Models\Tarefa.pas"/>
        <DCCReference Include="..\Compartilhada\Models\EstatisticasTarefas.pas"/>
        <DCCReference Include="src\config\ConfiguracaoBanco.pas"/>
        <DCCReference Include="src\database\Conexao.Interfaces.pas"/>
        <DCCReference Include="src\database\Conexao.Base.pas"/>
        <DCCReference Include="src\database\Conexao.ADO.pas"/>
        <DCCReference Include="src\database\Conexao.Factory.pas"/>
        <DCCReference Include="src\database\ConsultaPaginada.pas"/>
        <DCCReference Include="src\repositories\TarefaRepository.Interfaces.pas"/>
        <DCCReference Include="src\repositories\TarefaRepository.SQLServer.pas"/>
        <DCCReference Include="src\services\ServiceExceptions.pas"/>
        <DCCReference Include="src\services\TarefaService.Interfaces.pas"/>
        <DCCReference Include="src\services\TarefaService.pas"/>
        <DCCReference Include="src\config\Container.pas"/>
        <DCCReference Include="src\http\RespostaHttp.pas"/>
        <DCCReference Include="src\controllers\BaseController.pas"/>
        <DCCReference Include="src\controllers\TarefaController.pas"/>
        <DCCReference Include="src\log\LogApi.pas"/>
        <DCCReference Include="src\middleware\LogRequisicaoMiddleware.pas"/>
        <DCCReference Include="src\middleware\ApiKeyMiddleware.pas"/>
        <DCCReference Include="src\routes\TarefaRoutes.pas"/>
        <DCCReference Include="src\routes\Routes.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">Api.dpr</Source>
                </Source>
            </Delphi.Personality>
            <Platforms>
                <Platform value="Win32">True</Platform>
                <Platform value="Win64">False</Platform>
            </Platforms>
        </BorlandProject>
        <ProjectFileVersion>12</ProjectFileVersion>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
</Project>
